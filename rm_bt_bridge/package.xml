<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rm_bt_bridge</name>
  <version>0.1.0</version>
  <description>Bridges the PB referee simulator to COD behavior-tree messages, and forwards /goal_pose to Nav2 navigate_to_pose action.</description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>rm_referee_interfaces</depend>
  <depend>rm_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
